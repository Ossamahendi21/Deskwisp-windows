[Unit]
Description=Deskwisp Cloud (keys, webhooks and calls for hosted Deskwisp)
After=network-online.target
Wants=network-online.target

[Service]
User=deskwisp
Group=deskwisp
WorkingDirectory=/opt/deskwisp
# Provider keys, the database URL and DESKWISP_CLOUD_SECRET (from Horafirm's prod/deskwisp-secrets.env), plus the
# public settings (prod/deskwisp-public.env). scripts/cloud-deploy.sh writes it, mode 0640 root:deskwisp.
EnvironmentFile=/etc/deskwisp-cloud/env
ExecStart=/usr/local/bin/node /opt/deskwisp/cloud/server.ts
Restart=always
RestartSec=2
TimeoutStopSec=10
LimitNOFILE=65536
# It shares the box with horafirm-web: never more than 2 of its cores and 4 GB.
CPUQuota=200%
MemoryMax=4G

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadOnlyPaths=/opt/deskwisp

[Install]
WantedBy=multi-user.target

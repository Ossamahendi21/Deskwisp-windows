
# Deskwisp Cloud (the deskwisp repo's cloud/, deskwisp-cloud.service on this box), added by its
# cloud/deploy/install.sh as a site of its own, so nothing in app.deskwisp.com's block changes.
# 127.0.0.1, never "localhost:<port>": horafirm-web's deploy rewrites those to its own replicas.
DESKWISP_SITE {
	handle_path DESKWISP_CLOUD_PATH/* {
		reverse_proxy 127.0.0.1:8790 {
			flush_interval -1
		}
	}
	handle {
		respond "Not found" 404
	}
}

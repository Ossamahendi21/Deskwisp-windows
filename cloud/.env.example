# Deskwisp's services server (cloud/): it holds the provider keys, so no key ever sits on a user's PC.
# The app reaches OpenAI, Composio, Honcho, Typesafe and treg through it, and it takes each use from
# the user's AI credit. Copy to cloud/.env and fill in. Never commit cloud/.env, never paste it anywhere.
#
#   node --experimental-strip-types --env-file=cloud/.env cloud/server.ts     (Node 22; Node 24: node cloud/server.ts)

# ---- Where it runs
DESKWISP_CLOUD_PORT=8790
# The address the internet reaches it at (webhooks, the "connected" page). On your PC: as is.
DESKWISP_CLOUD_PUBLIC_URL=http://127.0.0.1:8790
# Neon, the same database as dcloud, but the connection string WITHOUT "-pooler" in the host (this
# server holds locks for a while, which Neon's pooler can't keep).
DESKWISP_DATABASE_URL=
# 32 random bytes, base64 (it seals the secrets this server keeps). Make one in Git Bash:
#   openssl rand -base64 32
DESKWISP_CLOUD_SECRET=
# Who's signed in: Deskwisp's account server (dcloud).
DESKWISP_HORAFIRM_ORIGIN=http://127.0.0.1:8791
# Take each use from the user's AI credit, and stop their bots when it's used up (db/005_ai_credit.sql in dcloud).
DESKWISP_AI_CREDITS=1
# The same secret as dcloud's DESKWISP_CLOUD_PLAN_SECRET: dcloud tells this server when a plan changes.
DESKWISP_CLOUD_PLAN_SECRET=

# ---- OpenAI (required): platform.openai.com → API keys
OPENAI_API_KEY=
# A second key the bots' computers use for their own runs. It's copied onto each computer, where the
# user has full control, so make it in a separate OpenAI project with a monthly budget limit.
OPENAI_EXECUTOR_API_KEY=

# ---- Composio (apps: Gmail, Slack, …): platform.composio.dev → API keys. Free up to 100K tool calls a month.
COMPOSIO_API_KEY=

# ---- Optional. A feature whose key is missing is shown as off in the app.
# Memory (Honcho), self-hosted on your server (github.com/plastic-labs/honcho, docker compose): where it
# listens, and any key (with AUTH_USE_AUTH=false on Honcho, it isn't checked).
# DESKWISP_UPSTREAM_HONCHO=http://127.0.0.1:8000
# HONCHO_API_KEY=self-hosted
# Quick checks (Typesafe's Jev): without it, a small OpenAI call answers them instead.
# TYPESAFE_API_KEY=
# Business data (treg.to): companies, people, work emails. Paid per call from the user's AI credit.
# TREG_TOKEN=
# Bots' email (AgentMail): agentmail.to. Free has 3 inboxes; with your own domain from the $20 plan.
# AGENTMAIL_API_KEY=
# DESKWISP_MAIL_DOMAIN=
# Each plan's emails (Free none, Pro 1, Max 5).
DESKWISP_PLAN_LIMITS=1

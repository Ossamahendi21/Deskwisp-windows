# Deskwisp's sites (docs/DEPLOY.md), for the Caddy already on the server or one install.sh sets up.
# install.sh puts this at /etc/caddy/deskwisp.caddy and adds one line to /etc/caddy/Caddyfile to
# take it in (import), so every other site there stays as it is. Caddy gets and renews each name's
# HTTPS certificate itself, once its DNS points here. 127.0.0.1, never the internet, for the servers.

# The website.
deskwisp.com {
	root * /var/www/deskwisp
	file_server
	encode gzip
	# What the apps read to find a new version (scripts/release-win.sh): always asked for afresh.
	@latest path /download/latest.json /download/win/latest.json
	header @latest Cache-Control "no-cache"
	# The website's download (always the newest, under the same name) and the logo files: checked
	# afresh too, so after a release or a new logo nobody gets the one their browser kept.
	@fresh path /download/Deskwisp-Setup.exe /deskwisp.png /apple-touch-icon.png /og.png
	header @fresh Cache-Control "no-cache"
	# Pages and their stylesheet: the browser checks for a newer one every time (a quick 304 when
	# nothing changed), so a new version of the site shows at once, not after the cache runs out.
	@pages path / /*.html /*.css /*.js /privacy/ /terms/
	header @pages Cache-Control "no-cache"
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

www.deskwisp.com {
	redir https://deskwisp.com{uri} permanent
}

# Accounts, sign-in, the bots' computers and their screens, plans and billing (dcloud/, port 8791).
app.deskwisp.com {
	reverse_proxy 127.0.0.1:8791 {
		flush_interval -1
	}
}

# The services (cloud/, port 8790), under /api as the app expects (DESKWISP_CLOUD_PUBLIC_URL
# https://cloud.deskwisp.com/api): the prefix is taken off before it gets there.
cloud.deskwisp.com {
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8790 {
			flush_interval -1
		}
	}
	handle {
		respond "Not found" 404
	}
}

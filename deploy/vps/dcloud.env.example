# dcloud/ on the server (docs/DEPLOY.md): install.sh copies this to /etc/deskwisp/dcloud.env once.
# Fill in the keys there (sudo nano /etc/deskwisp/dcloud.env), never in the repo. What each one is:
# dcloud/.env.example.

DESKWISP_HOST=127.0.0.1
DESKWISP_PORT=8791
DESKWISP_PUBLIC_URL=https://app.deskwisp.com
DESKWISP_DATA_DIR=/var/lib/deskwisp/dcloud

# Neon, the connection string with "-pooler" in it.
DATABASE_URL=
# Clerk's production instance (its domain deskwisp.com).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Invite emails, through the same Resend account as the bots' mail.
RESEND_API_KEY=
DESKWISP_MAIL_FROM=Deskwisp <hello@deskwisp.com>

DESKWISP_PROVIDER=e2b
E2B_API_KEY=
E2B_TEMPLATE=deskwisp-computer
DESKWISP_IDLE_MINUTES=15
DESKWISP_MAX_COMPUTERS=3
DESKWISP_COMPUTER_CPU=2
DESKWISP_COMPUTER_RAM_GB=4

# cloud/ on this same server, and the secret both have (the same value in cloud.env).
DESKWISP_SERVICES_URL=http://127.0.0.1:8790
DESKWISP_CLOUD_PLAN_SECRET=

# Polar. Its webhook: https://app.deskwisp.com/billing/polar/webhook
POLAR_ACCESS_TOKEN=
POLAR_CREDIT_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=
POLAR_MAX_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=
# Only once selling Deskwisp is cleared (COMMERCIAL-PERMISSION.md):
# POLAR_SERVER=production
# DESKWISP_LIVE_PAYMENTS=1

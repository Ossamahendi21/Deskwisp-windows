# cloud/ on the server (docs/DEPLOY.md): install.sh copies this to /etc/deskwisp/cloud.env once.
# Fill in the keys there (sudo nano /etc/deskwisp/cloud.env), never in the repo. What each one is:
# cloud/.env.example.

DESKWISP_CLOUD_PORT=8790
DESKWISP_CLOUD_PUBLIC_URL=https://cloud.deskwisp.com/api
# Neon, the connection string WITHOUT "-pooler", ending in sslmode=verify-full.
DESKWISP_DATABASE_URL=
# 32 random bytes, base64 (openssl rand -base64 32). Keep it: it opens the keys cloud/ has sealed.
DESKWISP_CLOUD_SECRET=
# Sign-ins are checked by dcloud/ on this same server.
DESKWISP_HORAFIRM_ORIGIN=http://127.0.0.1:8791
DESKWISP_AI_CREDITS=1
# The same value as in dcloud.env.
DESKWISP_CLOUD_PLAN_SECRET=
DESKWISP_PLAN_LIMITS=1

OPENAI_API_KEY=
OPENAI_EXECUTOR_API_KEY=
DESKWISP_FREE_MODEL=gpt-6-luna
COMPOSIO_API_KEY=

# Bots' email (Deskwisp Mail): wispy.<handle>@deskwisp.com, in through Cloudflare, out through Resend.
RESEND_API_KEY=
DESKWISP_MAIL_DOMAIN=deskwisp.com
# The same value as the Cloudflare Worker's INBOUND_SECRET (openssl rand -base64 32).
DESKWISP_MAIL_INBOUND_SECRET=

# Bots' phone numbers (AgentPhone, US and Canadian numbers): one account of Deskwisp's, a sub-account
# for each user made at their first session. Its webhook: https://cloud.deskwisp.com/api/hooks/agentphone
# (set for each number by Deskwisp itself). Users pay from their AI credit at twice AgentPhone's price
# (cloud/pricing.ts, PHONE_MARKUP); Pro's and Max's own numbers are included.
AGENTPHONE_API_KEY=
DESKWISP_PHONE_AREA=415
# Optional: owners prove their own mobile with a texted code (Twilio Verify). Without it, a new number's
# first caller in 15 minutes becomes its owner.
TWILIO_ACCOUNT_SID=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

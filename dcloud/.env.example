# Deskwisp Cloud settings. Copy to dcloud/.env and fill in. Never commit dcloud/.env, never paste it anywhere.

# Where it listens. Behind a reverse proxy (Caddy) in production; 127.0.0.1 keeps it off the network.
DESKWISP_HOST=127.0.0.1
DESKWISP_PORT=8791
# The address people's browsers reach it at: the sign-in page is here. On your PC, leave it as is.
DESKWISP_PUBLIC_URL=http://localhost:8791
# Its files when there's no database (development).
DESKWISP_DATA_DIR=./.dcloud-data

# ---- Accounts (step 2.2)

# Neon: neon.com → your project → Connect → the connection string with "-pooler" in it.
DATABASE_URL=
# Clerk: dashboard.clerk.com → your app → API Keys. The secret key stays here; the publishable one is
# public (it goes on the sign-in page).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Optional, for development only: fixed keys that work without signing in, as key=name pairs.
# DESKWISP_API_KEYS=a-long-random-key=me

# ---- Computers (step 2.1)

# Where the bots' computers run: e2b (real) or local (development only: no isolation).
DESKWISP_PROVIDER=e2b
# e2b.dev → Dashboard → API Keys.
E2B_API_KEY=
# The template built by dcloud/template/build.ts.
E2B_TEMPLATE=deskwisp-computer

# A computer pauses this long after its last use, and wakes on the next. Paused, it costs nothing.
DESKWISP_IDLE_MINUTES=15
# Computers per user, and their size (what E2B bills by the second while one runs).
DESKWISP_MAX_COMPUTERS=3
DESKWISP_COMPUTER_CPU=2
DESKWISP_COMPUTER_RAM_GB=4

# Deskwisp settings. Copy to .env.local and fill in what you use. Never commit .env.local.
# The person the bots work for (name, about) is set in the app: Settings → You.
#
# Two ways to run the app:
# - Hosted (what users get): leave DESKWISP_SELF_HOSTED empty. Users sign in to Deskwisp (dcloud,
#   DESKWISP_HORAFIRM_ORIGIN), and every service (OpenAI, Composio, memory…) goes through Deskwisp's services
#   server (cloud/, DESKWISP_CLOUD_URL), which holds the keys and takes each use from the user's AI
#   credit. No keys in this file then: they're in cloud/.env on the server.
# - Self-hosted: DESKWISP_SELF_HOSTED=1 and your own keys below; the app calls every service directly.
DESKWISP_SELF_HOSTED=
# Usage events (README, Privacy). Signed in with Horafirm, the app sends Horafirm counts of what's done in Deskwisp
# through PostHog, never content; self-hosting sends nothing. 0 turns them off on this Mac (so does
# DO_NOT_TRACK=1), and Deskwisp Cloud then sends none for what this Mac does (account events the cloud
# sees on its own, like AI credit running out or a plan change, stop only with Settings → You →
# Share usage data). 1 sends them from a development build too, as environment "development".
DESKWISP_TELEMETRY=
# Deskwisp's services server (cloud/), hosted mode. On your PC while developing: http://127.0.0.1:8790.
DESKWISP_CLOUD_URL=

# --- Required ---------------------------------------------------------------
# OpenAI: chat, calls (GPT-Live) and the bots' agent runs.
OPENAI_API_KEY=
# Key the bots' computers use for their own Codex runs (an OpenAI key; can be the same project).
OPENAI_EXECUTOR_API_KEY=
# Horafirm: the bots' cloud computers. Users sign in with Horafirm in the app, and Deskwisp runs on their own
# account. This key is only for self-hosting: with DESKWISP_SELF_HOSTED=1 and HORAFIRM_API_KEY set, the app
# skips the sign-in screen and uses this key (or ~/.horafirm/credentials.json) whenever nobody is signed in.
HORAFIRM_API_KEY=
# Which Horafirm to sign in to and call (default https://app.deskwisp.com). Point it at staging or a local
# Horafirm while developing.
DESKWISP_HORAFIRM_ORIGIN=
# Routing the bots' computers through this Mac (lib/server/relay.ts) runs the horafirm-relay agent:
# this binary, else vendor/horafirm-relay/horafirm-relay (scripts/fetch-relay.sh), else one on PATH. The
# packaged app sets it to its bundled copy. Its loopback status API listens on DESKWISP_RELAY_CONTROL
# (default 127.0.0.1:8897).
DESKWISP_RELAY_BIN=
DESKWISP_RELAY_CONTROL=
# The Horafirm workspace for Deskwisp' computers, for self-hosting on HORAFIRM_API_KEY. Unset, or with a user
# signed in: their own workspace named "deskwisp" (made the first time).
# Deskwisp only ever creates or deletes computers inside this workspace.
DESKWISP_HORAFIRM_WORKSPACE=
# The Horafirm template bot computers launch from (default system/deskwisp-base@0.1.8, Horafirm's own public copy,
# there for every account, and the only one a free Deskwisp computer is made from). Build your own with
# `node horafirm/deskwisp-base.mjs publish` and put its ref here.
DESKWISP_HORAFIRM_TEMPLATE=
# Disk per bot computer, in GB (default 120; your Horafirm plan sets the most). Disks only ever grow.
DESKWISP_DISK_GB=

# --- Recommended ------------------------------------------------------------
# Typesafe: the small yes/no judgments (is this risky, which bot, is this a fact).
TYPESAFE_API_KEY=
# Composio: your connected apps (any of ~1,000, several accounts each) and the Slack app bots join
# channels through. User id defaults to one per install.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
# treg (treg.to): business data for every bot (companies, people, work emails, phones, company news,
# hiring and funding, local businesses, and the rest of treg's catalog). An org-scoped token
# (`treg org agent-new deskwisp`); each call is paid from that team's treg balance. Set on a Mac signed in
# with Horafirm, it's used instead of Deskwisp Cloud's (to try business data before the cloud has it).
TREG_TOKEN=
# Honcho: long-term memory. Workspace and your peer id in it (defaults: "deskwisp", "user").
HONCHO_API_KEY=
HONCHO_WORKSPACE_ID=
HONCHO_USER_PEER=
# Tailscale: lets bots' computers join your tailnet for a direct, private live view.
TAILSCALE_AUTH_KEY=
# 1 streams the bots' other screens live through Horafirm (its noVNC proxy, ?screen=) when their computer
# isn't on the tailnet; otherwise they show as screenshots. Off by default until deskwisp.com serves
# per-screen streams: an Horafirm without them streams the main screen in a bot's tile instead.
DESKWISP_SCREEN_STREAM=

# --- Email (AgentMail) --------------------------------------------------------
AGENTMAIL_API_KEY=
# Domain for the bots' addresses (default deskwisp.bot; a custom domain must be verified in AgentMail).
DESKWISP_MAIL_DOMAIN=
# Optional fixed pod (default: one per install).
AGENTMAIL_POD_ID=
# Your own email addresses, comma-separated, besides a connected Gmail, the ones verified in Settings
# and your Horafirm sign-in email once you count it there: mail to these needs no approval, mail from them
# (DMARC passing) is you. Your bots' inboxes and agentmail.to or deskwisp.bot addresses never count.
DESKWISP_OWNER_EMAILS=

# --- Phone (AgentPhone + GPT-Live over SIP) --------------------------------------
AGENTPHONE_API_KEY=
AGENTPHONE_SUB_ACCOUNT=
# Secret of the sub-account webhook (per-agent secrets are kept in .data/phone-secrets.json).
AGENTPHONE_WEBHOOK_SECRET=
# Public URL AgentPhone delivers to, e.g. https://api.example.com/hooks/agentphone (see edge/).
DESKWISP_AGENTPHONE_HOOK_URL=
# Area code for new bot numbers (default 415).
DESKWISP_PHONE_AREA=
# Texts (or emails) the code that proves a mobile number (or an email address) in Settings, How your
# bots reach you, is the user's (Twilio Verify). Only verified ones count as the user. Server
# secrets: never in the desktop app or a commit.
# The Verify service's SID (VA...), and an API key for it (or TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN).
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Countries codes may be texted to: calling codes, comma separated ("1,44"). Unset: US and Canada
# only (+1 without the Caribbean area codes; name one outright, like 1876, to allow it).
DESKWISP_VERIFY_COUNTRIES=
# Codes by email need an email sender attached to the Verify service (a SendGrid Email Integration).
# Unset: Deskwisp reads the service's mailer_sid and offers email codes only when there is one. 0 turns
# email codes off; 1 skips that check (when the service has a sender but doesn't report it).
DESKWISP_VERIFY_EMAIL=
# Self-hosting override: mobile numbers that count as you WITHOUT a texted code, comma-separated.
# Anyone can put any number here, so never set it on a hosted (multi-user) server.
DESKWISP_OWNER_PHONES=
# Contact in the SMS HELP reply (carriers require one).
DESKWISP_SUPPORT_EMAIL=
# 1 = write texts into the chat instead of sending them (for testing routing).
DESKWISP_PHONE_DRY_RUN=
# OpenAI project webhook secret (live.transport.incoming, for calls).
OPENAI_WEBHOOK_SECRET=

# --- Hosted server ---------------------------------------------------------------
# Postgres for hosted Deskwisp: each Horafirm user's state in one database (see db/README.md). Unset, the
# Mac app keeps each user's state in Deskwisp Cloud, and a self-hosted install (DESKWISP_SELF_HOSTED=1) in
# .data/users/<id>/state.json. Never commit the real one.
DESKWISP_DATABASE_URL=
# Pin this server to one Horafirm user id; unset, it loads whoever signs in.
DESKWISP_HORAFIRM_USER_ID=
# The name (or names, comma separated) people reach this hosted server by, e.g. deskwisp.example.com.
# Behind a reverse proxy that rewrites Host, the public name the browser uses. Unset, a hosted server
# takes any name and only checks that requests come from its own page (proxy.ts).
DESKWISP_PUBLIC_HOST=

# --- Models (defaults in code) --------------------------------------------------
DESKWISP_CHAT_MODEL=
DESKWISP_SESSION_MODEL=
DESKWISP_HARD_MODEL=
DESKWISP_CHAT_EFFORT=
# New cloud tasks run on the Responses API's computer tool (lib/server/computer-task.ts); 0 puts them on an Agents API session instead
DESKWISP_COMPUTER_TOOL=

# --- Mac ---------------------------------------------------------------------
# Path to cua-driver (default ~/.local/bin/cua-driver).
CUA_DRIVER_PATH=
# 1 = show the background Chrome windows instead of running them headless.
DESKWISP_CHROME_WINDOWS=

# --- Optional: where Deskwisp reaches Telegram and Discord (a proxy, or a stand-in for tests) ---
# Bots' Telegram and Discord tokens live in the Mac's Keychain, never here.
DESKWISP_TELEGRAM_API=
DESKWISP_DISCORD_API=

# --- Self-hosting only: Deskwisp' public address and its own Slack app -------------
# Signed in with Horafirm, Deskwisp Cloud has both (its public address, and Horafirm's "Deskwisp" Slack app, whose
# events it passes to the Mac over the tunnel), and the app doesn't use these: set them with DESKWISP_SELF_HOSTED=1.
# Where the "connected" page, OAuth callbacks and the bots' pictures live (edge/, on Fly). Default api.deskwisp.bot.
DESKWISP_PUBLIC_URL=
# Deskwisp' own Slack app (slack/setup.mjs fills these): Slack shows "Deskwisp" and each bot under its own name
# and picture, and Slack's events come to DESKWISP_PUBLIC_URL/hooks/slack, checked with the signing secret.
# Without them, Slack goes through Composio's shared app and its triggers.
DESKWISP_SLACK_APP_ID=
DESKWISP_SLACK_CLIENT_ID=
DESKWISP_SLACK_CLIENT_SECRET=
DESKWISP_SLACK_SIGNING_SECRET=
DESKWISP_SLACK_VERIFICATION_TOKEN=
DESKWISP_SLACK_AUTH_CONFIG=

{
  "appId": "app.deskwisp.windows",
  "productName": "Deskwisp",
  "directories": {
    "output": "dist-win"
  },
  "extraMetadata": {
    "main": "desktop/win-main.cjs",
    "productName": "Deskwisp",
    "description": "Deskwisp: a team of AI bots for your business ops."
  },
  "files": [
    "desktop/**/*",
    "!desktop/main.cjs",
    "!desktop/*.icns",
    "!node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "server",
      "filter": [
        "**/*",
        "!.env*",
        "!.data/**"
      ]
    },
    {
      "from": ".next/standalone/node_modules",
      "to": "server/node_modules"
    },
    {
      "from": ".next/static",
      "to": "server/.next/static"
    },
    {
      "from": "public",
      "to": "server/public"
    }
  ],
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "publish": null,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "signAndEditExecutable": true
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Deskwisp",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "include": "build/installer.nsh",
    "artifactName": "Deskwisp-Setup-${version}-x64.${ext}"
  },
  "appx": {
    "identityName": "HorafirmLLC.Deskwisp",
    "publisher": "CN=0472D7ED-2092-4944-9FB1-6C60A776FCC5",
    "publisherDisplayName": "Horafirm LLC",
    "applicationId": "Deskwisp",
    "displayName": "Deskwisp",
    "backgroundColor": "#7C5CFF",
    "languages": [
      "en-US"
    ],
    "capabilities": [
      "internetClient",
      "microphone"
    ],
    "artifactName": "Deskwisp-${version}-x64.${ext}"
  }
}
